# ASCON devnet (値は contact@nyx.foundation からのメールで確認。実値は .env にのみ書く)
ASCON_RPC_URL=https://ascon-rpc.nyx.foundation/
ASCON_CHAIN_ID=31337
# RPC 認証ヘッダ3つ（ヘッダ名・値はメール記載のとおり。チーム専用キーは他チームと共有しない）
ASCON_HEADER_1_NAME=
ASCON_HEADER_1_VALUE=
ASCON_HEADER_2_NAME=
ASCON_HEADER_2_VALUE=
ASCON_HEADER_3_NAME=
ASCON_HEADER_3_VALUE=
# devnet 専用の新規ウォレット秘密鍵（普段使い・Anvil 既定鍵は使わない）
AGENT_PRIVATE_KEY=
